# The backend's base URL (no trailing slash, no /api suffix).
# Required for production builds (Vercel) — set it there as an Environment
# Variable, not in a committed file.
#
# Optional for local dev: if unset, `npm run dev` talks to
# http://localhost:7500. Copy this file to `.env.local` (gitignored) and set
# this to point your local frontend at the deployed Render backend instead
# of running the backend locally.
VITE_API_URL=https://your-backend.onrender.com
